rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: uid, displayName, email, weight, height, age, gender, activityLevel, goal, createdAt
    //
    // Collection: dietLogs
    // Fields: uid, date, mealType, foodName, calories, protein, carbs, fat, timestamp
    //
    // Collection: exerciseLogs
    // Fields: uid, date, activityType, duration, caloriesBurned, timestamp
    //
    // Collection: weightLogs
    // Fields: uid, date, weight, timestamp
    //
    // Collection: menstrualLogs
    // Fields: uid, date, flow, symptoms, notes, timestamp
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isRequestOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }

    function isValidUser(data) {
      return data.uid is string && data.email is string;
    }

    function isValidDietLog(data) {
      return data.uid is string && data.date is string && data.foodName is string && data.calories is number;
    }

    function isValidExerciseLog(data) {
      return data.uid is string && data.date is string && data.activityType is string && data.duration is number;
    }

    function isValidWeightLog(data) {
      return data.uid is string && data.date is string && data.weight is number;
    }

    function isValidMenstrualLog(data) {
      return data.uid is string && data.date is string;
    }

    // Rules
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if isOwner(uid) && isValidUser(request.resource.data);
    }

    match /dietLogs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isRequestOwner() && isValidDietLog(request.resource.data);
      allow update: if isDocOwner() && isRequestOwner() && isValidDietLog(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /exerciseLogs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isRequestOwner() && isValidExerciseLog(request.resource.data);
      allow update: if isDocOwner() && isRequestOwner() && isValidExerciseLog(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /weightLogs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isRequestOwner() && isValidWeightLog(request.resource.data);
      allow update: if isDocOwner() && isRequestOwner() && isValidWeightLog(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /menstrualLogs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isRequestOwner() && isValidMenstrualLog(request.resource.data);
      allow update: if isDocOwner() && isRequestOwner() && isValidMenstrualLog(request.resource.data);
      allow delete: if isDocOwner();
    }
  }
}
